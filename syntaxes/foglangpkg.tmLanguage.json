{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "foglangpkg",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#packagelist"
		}
	],
	"repository": {
		"comments": {
			"patterns": [{
				"name": "comment.block.foglangpkg",
				"begin": "[^*]?#\\*",
				"end": "\\*#"
			},
			{
				"name": "comment.line.double-slash.foglangpkg",
				"match": "#.*"
			}
			
			]
		},
		"packagelist": {
			"patterns": [
				{
					"name": "comment.foglangpkg",
					"match": "(?<=[^ ]+ [^ ]+ )([^ ]+)"
				},
				{
                    "name": "storage.type.foglangpkg",
                    "match": "(?<=[^ ]+ )([^ ]+)"
                },
				{
					"name": "entity.name.function.foglangpkg",
					"match": "([^ ]+)"
				}
			]
		}
	},
	"scopeName": "source.foglangpkg"
}