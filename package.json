{
  "name": "foglanghighlight",
  "repository": "https://github.com/handej08/foglanghighlight",
  "displayName": "FoglangHighlight",
  "description": "Syntax Highlight for the Foglang programming language!",
  "icon": "fogiconfull.png",
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "foglang",
      "aliases": ["Foglang", "foglang"],
      "extensions": [".fg"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "fogicon.svg",
        "dark": "fogicon.svg"
      }
    },
    {
      "id": "foglangpkg",
      "aliases": ["Foglang Package", "foglang package"],
      "extensions": [".fgpkg"],
      "configuration": "./pkg-language-configuration.json",
      "icon": {
        "light": "packageicon.svg",
        "dark": "packageicon.svg"
      }
    }],
    "grammars": [{
      "language": "foglang",
      "scopeName": "source.foglang",
      "path": "./syntaxes/foglang.tmLanguage.json"
    },
    {
      "language": "foglangpkg",
      "scopeName": "source.foglangpkg",
      "path": "./syntaxes/foglangpkg.tmLanguage.json"
    }]
  }
}
